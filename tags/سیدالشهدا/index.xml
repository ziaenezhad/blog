<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>سیدالشهدا on رفتن</title><link>https://ziaenezhad.ir/tags/%D8%B3%DB%8C%D8%AF%D8%A7%D9%84%D8%B4%D9%87%D8%AF%D8%A7/</link><description>Recent content in سیدالشهدا on رفتن</description><generator>Hugo -- gohugo.io</generator><language>fa_IR</language><lastBuildDate>Sun, 10 Sep 2023 00:00:00 +0000</lastBuildDate><atom:link href="https://ziaenezhad.ir/tags/%D8%B3%DB%8C%D8%AF%D8%A7%D9%84%D8%B4%D9%87%D8%AF%D8%A7/index.xml" rel="self" type="application/rss+xml"/><item><title>روزنه</title><link>https://ziaenezhad.ir/p/%D8%B1%D9%88%D8%B2%D9%86%D9%87/</link><pubDate>Sun, 10 Sep 2023 00:00:00 +0000</pubDate><guid>https://ziaenezhad.ir/p/%D8%B1%D9%88%D8%B2%D9%86%D9%87/</guid><description>&lt;img src="https://ziaenezhad.ir/p/%D8%B1%D9%88%D8%B2%D9%86%D9%87/joshua-earle-yi6dvuynEuo-unsplash.jpg" alt="Featured image of post روزنه" /&gt;&lt;p&gt;حجابِ عصر مدرن،&lt;/p&gt;&#10;&lt;p&gt;که با تمام پیکرش&lt;/p&gt;&#10;&lt;p&gt;انکار وجود عالم غیب است را،&lt;/p&gt;&#10;&lt;p&gt;به زیر کشیده شده گانیم.&lt;/p&gt;&#10;&lt;hr&gt;&#10;&lt;p&gt;خون شهید،&lt;/p&gt;&#10;&lt;p&gt;آنگاه که با تمام پیکرش به خاک می افتد،&lt;/p&gt;&#10;&lt;p&gt;و روزنه ای به ماورای طبیعت&lt;/p&gt;&#10;&lt;p&gt;بر آن پرده زخیم می گشاید را،&lt;/p&gt;&#10;&lt;p&gt;فراموش کننده گانیم.&lt;/p&gt;&#10;&lt;hr&gt;&#10;&lt;p&gt;صد بار باید بنویسم:&lt;/p&gt;&#10;&lt;p&gt;خون شهید،&lt;/p&gt;&#10;&lt;p&gt;فاش می کند&lt;/p&gt;&#10;&lt;p&gt;سقف بلند اسرار خلقت را.&lt;/p&gt;&#10;</description></item><item><title>بیابان</title><link>https://ziaenezhad.ir/p/%D8%A8%DB%8C%D8%A7%D8%A8%D8%A7%D9%86/</link><pubDate>Fri, 28 Jul 2023 00:00:00 +0000</pubDate><guid>https://ziaenezhad.ir/p/%D8%A8%DB%8C%D8%A7%D8%A8%D8%A7%D9%86/</guid><description>&lt;img src="https://ziaenezhad.ir/p/%D8%A8%DB%8C%D8%A7%D8%A8%D8%A7%D9%86/neom-AC3T7tvwPrY-unsplash.jpg" alt="Featured image of post بیابان" /&gt;&lt;p&gt;ماییم و شب سیاه گمراهی&lt;/p&gt;&#10;&lt;p&gt;ای نور شب افروز&lt;/p&gt;&#10;&lt;p&gt;شلاق خورده نفس سرکشیم و بی نفس به خاک مذلت افتاده&lt;/p&gt;&#10;&lt;p&gt;ای ستاره هدایت کاروان خطا کاران&lt;/p&gt;&#10;&lt;p&gt;کجاست نمی که تر کند لب خشکیده گنه کاری&lt;/p&gt;&#10;&lt;p&gt;کجاست آیتی، نوری که جهت دهد، سرگشته ای در بیابانی&lt;/p&gt;&#10;</description></item></channel></rss>